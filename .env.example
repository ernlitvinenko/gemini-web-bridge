# --- Server ---------------------------------------------------------------
GEMINI_BRIDGE_HOST=127.0.0.1
GEMINI_BRIDGE_PORT=8000

# Recommended: set a local key. Send it as "Authorization: Bearer <key>".
GEMINI_BRIDGE_API_KEY=sk-local-change-me

# --- Gemini Web / Chrome --------------------------------------------------
GEMINI_BRIDGE_GEMINI_URL=https://gemini.google.com/app
GEMINI_BRIDGE_PROFILE_DIR=~/.gemini-web-bridge/profile
GEMINI_BRIDGE_HEADLESS=false
GEMINI_BRIDGE_BROWSER_CHANNEL=chrome
# GEMINI_BRIDGE_BROWSER_EXECUTABLE=/path/to/Google Chrome
GEMINI_BRIDGE_BROWSER_ARGS=--disable-blink-features=AutomationControlled
GEMINI_BRIDGE_ACCEPT_COOKIES=true
GEMINI_BRIDGE_REQUIRE_LOGIN=true

# --- Models ---------------------------------------------------------------
# gemini-web-pro selects the "Pro" entry in Gemini's mode picker.
GEMINI_BRIDGE_DEFAULT_MODEL=gemini-web-pro
GEMINI_BRIDGE_MODEL_MAP={"gemini-web":null,"gemini-web-auto":null,"gemini-web-pro":"Pro","gemini-web-flash":"Flash","gemini-web-flash-lite":"Flash-Lite","gemini-web-argon":"Argon","gemini-2.5-pro":"Pro","gemini-2.5-flash":"Flash","gemini-3-pro":"Pro","gemini-3-flash":"Flash"}

# --- Timeouts and limits --------------------------------------------------
GEMINI_BRIDGE_MODEL_OPTION_TIMEOUT_S=12
GEMINI_BRIDGE_RESPONSE_START_TIMEOUT_S=120
GEMINI_BRIDGE_REQUEST_TIMEOUT_S=300
GEMINI_BRIDGE_LOCK_WAIT_TIMEOUT_S=300
GEMINI_BRIDGE_STABILITY_MS=1500
GEMINI_BRIDGE_POLL_INTERVAL_MS=250
GEMINI_BRIDGE_PAGE_TIMEOUT_MS=15000
GEMINI_BRIDGE_MAX_PROMPT_CHARS=200000

# --- Diagnostics ----------------------------------------------------------
GEMINI_BRIDGE_LOG_LEVEL=INFO
GEMINI_BRIDGE_DEBUG_ARTIFACTS=true
GEMINI_BRIDGE_DEBUG_DIR=~/.gemini-web-bridge/debug
